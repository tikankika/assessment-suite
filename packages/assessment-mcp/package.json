{
  "name": "mcp-assessment-server",
  "version": "0.8.0",
  "description": "MCP Server for AI-Augmented Analytical Assessment - Teacher-controlled workflow for structured student grading",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "assessment",
    "grading",
    "analytical-assessment",
    "education",
    "teacher-tools"
  ],
  "author": "Niklas Karlsson",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/ui": "^3.2.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tikankika/assessment-suite.git"
  },
  "private": true
}
